# Copy to .env and fill in values. Never commit .env.

# Triple Whale — sync_sales_bridge.py / sync_triplewhale_sales.py
TRIPLE_WHALE_API_KEY=

# Google Sheets — sync_sales_bridge.py
# Prefer GOOGLE_CREDS_FILE (path to service-account JSON). Inline JSON also works if properly quoted.
# GOOGLE_CREDS_FILE=/Extra/Yandex.Disk/Weatherman/Projects/gmail-milestone-tracker/gmail-milestone-tracker-497517-7162d422269c.json
# GOOGLE_CREDS_JSON=

# Geographic city weights for live stream (default: data/orders_by_city.csv)
# ORDERS_BY_CITY_PATH=data/orders_by_city.csv

# Optional: immutable historical sales ledger (real Shipping_City values, gitignored locally)
# HISTORICAL_SALES_LEDGER=data/historical_sales_ledger.csv

# Live Triple Whale window (days back from --end-date; default 7)
# LIVE_LOOKBACK_DAYS=7
# LIVE_SALES_START_DATE=2026-05-26
# DISABLE_HISTORY_ARCHIVE=1

# Committed archives: data/history/sales_ledger.csv (auto) + data/cleaned_omnichannel_sales.csv (2024+ bulk)

# Master transactional SKU bridge (combined US/UK/CA). Also set as GitHub secret for sales_bridge_sync.yml.
# SALES_BRIDGE_SPREADSHEET_ID=1kxCnllEkA_zxclhY3I9NrSQsNRecW6Dq4b9n8QrmbwU

# Optional: open bridge sheets by ID instead of title (from spreadsheet URL)
# SALES_BRIDGE_SPREADSHEET_ID_USA=
# SALES_BRIDGE_SPREADSHEET_ID_UK=
# SALES_BRIDGE_SPREADSHEET_ID_CAN=

# Daily audit workbooks (Weather_Pulse_Bridge_* - MM-DD-YY) — separate from sales bridge IDs.
# Required in GitHub Actions secrets for sales_bridge_sync.yml (copy from spreadsheet URL).
# AUDIT_BRIDGE_SPREADSHEET_ID_USA=
# AUDIT_BRIDGE_SPREADSHEET_ID_UK=
# AUDIT_BRIDGE_SPREADSHEET_ID_CAN=
# MARKETING_SNAPSHOT_DATE=2026-06-01

# Large Google Sheets writes (sync_sales_bridge.py master bridge)
# SHEET_WRITE_BATCH_ROWS=5000
# SHEET_BATCH_WRITE_THRESHOLD=8000
# SHEET_BATCH_PAUSE_S=0.5

# Master Sheets export only (full ledger stays in repo preview CSV / sales_ledger)
# MASTER_SHEETS_LOOKBACK_DAYS=730
# GOOGLE_SHEETS_CELL_BUFFER=500000

# GitHub Actions hourly retry (optional local testing with scripts/ci_retry.sh)
# CI_RETRY_MAX_ATTEMPTS=5
# CI_RETRY_WAIT_SECONDS=3600

# Shopify Custom App (client_credentials) — dailysalesreport.py
SHOPIFY_CUSTOM_APP_CLIENT_ID=
SHOPIFY_CUSTOM_APP_CLIENT_SECRET=

# Store hostnames (hostname only, no https://)
SHOPIFY_AU_NZ_STORE_URL=
SHOPIFY_UK_STORE_URL=
SHOPIFY_B2B_STORE_URL=
SHOPIFY_WM3_STORE_URL=

# Optional: Admin API tokens (shpat_…) for scripts/tools that need them — not used by dailysalesreport.py
SHOPIFY_UK_SHPAT=
SHOPIFY_AU_NZ_SHPAT=
SHOPIFY_WM3_SHPAT=
SHOPIFY_B2B_SHPAT=
